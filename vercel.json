{
  "version": 2,
  "functions": {
    "api/discover.js": { "maxDuration": 300 },
    "api/catalog.js":  { "maxDuration": 300 },
    "api/policies.js": { "maxDuration": 300 },
    "api/stylist.js":  { "maxDuration": 120 }
  },
  "routes": [
    { "src": "/api/discover",         "dest": "/api/discover" },
    { "src": "/api/recommendations",  "dest": "/api/recommendations" },
    { "src": "/api/feedback",         "dest": "/api/feedback" },
    { "src": "/api/(.*)",             "dest": "/api/$1" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/admin.html", "dest": "/public/admin.html" },
    { "src": "^/$", "dest": "/public/index.html" }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/catalog",
      "schedule": "30 1 * * *"
    }
  ]
}
